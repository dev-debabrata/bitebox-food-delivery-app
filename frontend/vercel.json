{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "buildCommand": "NG_BUILD_SASS_EMBEDDED=0 npm run build",
  "outputDirectory": "dist/frontend/browser",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://bitebox-backend-opal.vercel.app/api/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.csr.html"
    }
  ]
}

