{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "NG_BUILD_SASS_EMBEDDED=0 ng serve",
    "build": "NG_BUILD_SASS_EMBEDDED=0 ng build && cp dist/frontend/browser/index.csr.html dist/frontend/browser/index.html",
    "watch": "NG_BUILD_SASS_EMBEDDED=0 ng build --watch --configuration development",
    "test": "NG_BUILD_SASS_EMBEDDED=0 ng test",
    "serve:ssr:frontend": "node dist/frontend/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/cdk": "~22.2.5",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "~22.2.5",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.5",
    "compression": "^1.8.2",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "libphonenumber-js": "^1.13.15",
    "nexprime": "^0.1.5",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.4",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "nexprime": {
      "@angular/core": "$@angular/core",
      "@angular/common": "$@angular/common",
      "@angular/forms": "$@angular/forms",
      "@angular/cdk": "$@angular/cdk"
    }
  }
}
