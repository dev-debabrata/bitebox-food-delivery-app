# Netlify-style hosts: the service worker files decide which app version visitors run,
# so they must always be revalidated (never cached for long).
/ngsw-worker.js
  Cache-Control: no-cache
/ngsw.json
  Cache-Control: no-cache
/safety-worker.js
  Cache-Control: no-cache
/worker-basic.min.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
