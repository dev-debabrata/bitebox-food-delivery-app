{
  "id": "/",
  "name": "BiteBox - Food Delivery",
  "short_name": "BiteBox",
  "description": "Order food from your favourite local restaurants and track your delivery live.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "theme_color": "#ffffff",
  "background_color": "#2e1a3d",
  "categories": ["food", "shopping", "lifestyle"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/bitebox-favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "screenshots": [
    {
      "src": "/screenshot-wide.png",
      "sizes": "1280x900",
      "type": "image/png",
      "form_factor": "wide",
      "label": "BiteBox Restaurants on Desktop and Tablet"
    }
  ],
  "shortcuts": [
    {
      "name": "Restaurants",
      "short_name": "Restaurants",
      "description": "Browse restaurants near you",
      "url": "/restaurants",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "My orders",
      "short_name": "Orders",
      "description": "Track your orders",
      "url": "/orders",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
