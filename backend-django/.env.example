# BiteBox Django API settings. Copy to .env (never commit it). Real environment variables win.
# Values here are placeholders or local-development defaults; never put real secrets in this file.

# Which settings module: config.settings.development | staging | production
DJANGO_SETTINGS_MODULE=config.settings.development
# Required in staging/production (32+ characters). Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=
# Comma-separated host names the API answers for (required in staging/production)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (PostGIS from Phase 4). docker-compose overrides this for its own containers.
DATABASE_URL=postgres://bitebox:bitebox@localhost:5432/bitebox
DB_CONN_MAX_AGE=60
# Tests: a separate database whose name ends in _test. Unset = in-memory SQLite (skeleton only).
TEST_DATABASE_URL=

# Redis: Channels layer, Celery broker, cache
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL defaults to REDIS_URL
# Development without Redis: WebSockets in one process only
CHANNEL_LAYER_IN_MEMORY=false

# Sign-in (same names as the Node API). JWT_SECRET is required in staging/production (32+ chars):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Strict when the web app and API share a site (localhost:4200 + localhost:8000 do); None only cross-site
COOKIE_SAMESITE=Strict
PASSWORD_RESET_TTL_MINUTES=30
# Per-IP limits: <requests>/<seconds>s
AUTH_RATE_LIMIT=20/900s
SENSITIVE_RATE_LIMIT=5/900s
# Number of proxies in front of the API (nginx = 1), so rate limits see the client IP
TRUST_PROXY=0

# Email (password reset). Empty SMTP_HOST in development = emails printed to the console.
# Required in staging/production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=BiteBox <no-reply@example.com>

# Uploaded images: Cloudinary when all three keys are set, otherwise local disk (UPLOAD_DIR),
# served at PUBLIC_BASE_URL/uploads/images/...
PUBLIC_BASE_URL=http://localhost:8000
UPLOAD_DIR=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bitebox

# Free map services. Their usage policies need an identifying User-Agent and ~1 request/second;
# self-host Nominatim and OSRM for real traffic.
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=
GEOCODER_COUNTRY_CODES=in
ROUTING_URL=https://router.project-osrm.org
ROUTING_PROFILE=driving
# Per-IP limits: <requests>/<seconds>s
GEO_RATE_LIMIT=30/60s
COUPON_RATE_LIMIT=30/900s
IMAGE_UPLOAD_RATE_LIMIT=60/3600s
REVIEW_IMAGE_UPLOAD_RATE_LIMIT=30/3600s

# Web app origins allowed by CORS (comma separated), like the Node API's CLIENT_URL
CLIENT_URL=http://localhost:4200
# Time zone for daily reports and earnings
REPORT_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO

# Production behind nginx
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=2592000
# WEB_CONCURRENCY=2
# CELERY_CONCURRENCY=2

# Delivery OTP: a 4-digit code made at pickup, shown to the customer, needed to mark delivered.
DELIVERY_OTP_REQUIRED=true
DELIVERY_OTP_MAX_ATTEMPTS=5

# Payments. Razorpay is used when both keys are set (test keys start with rzp_test_). The webhook
# secret is the one entered in the Razorpay dashboard for /api/v1/payments/webhooks/razorpay.
# Without keys the simulated provider is offered (PAYMENTS_MOCK=false hides it; production never
# offers it).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENTS_MOCK=true
