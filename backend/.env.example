# Copy to .env and fill in values. Never commit .env.
NODE_ENV=development
PORT=5000

# MongoDB connection string (local or Atlas). Atlas/replica sets also enable transactions.
MONGO_URI=mongodb://127.0.0.1:27017/bitebox

# Allowed browser origins (comma-separated). The first one is used in emailed links.
CLIENT_URL=http://localhost:4200

# JWT signing secret: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Access-token lifetime (short; the refresh cookie renews it)
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
# strict | lax | none   (none requires HTTPS; use only if frontend and API are on different sites)
COOKIE_SAMESITE=strict
# Set to 1 when running behind one reverse proxy (needed for correct rate-limit IPs)
TRUST_PROXY=
BCRYPT_ROUNDS=12
LOG_LEVEL=debug

# SMTP for password-reset emails. If empty in development, emails are printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="BiteBox <no-reply@bitebox.local>"

# Development-only password used by `npm run seed` for all sample accounts.
SEED_PASSWORD=

# Image uploads go to Cloudinary when these three are set (Cloudinary console -> API Keys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder for BiteBox images in your Cloudinary media library.
CLOUDINARY_FOLDER=bitebox

# Without Cloudinary, images are saved on local disk. PUBLIC_BASE_URL is the API origin used in their URLs.
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:5000

# Place search / reverse geocoding. Default: public OpenStreetMap Nominatim (max 1 request/second,
# requests are cached and throttled by the API). Use a self-hosted or commercial geocoder in production.
GEOCODER_URL=https://nominatim.openstreetmap.org
# Required by Nominatim's usage policy: identify your app and give a contact address.
GEOCODER_USER_AGENT="BiteBoxApp/1.0 (BiteBox Food Delivery Platform; contact: support@bitebox.local)"
GEOCODER_COUNTRY_CODES=in

# Road routing for delivery routes and travel-time estimates. Default: the public OSRM demo server,
# which is for light testing only (no SLA, fair use, max ~1 request/second; the API caches and throttles).
# Use a self-hosted OSRM or a commercial routing provider in production.
ROUTING_URL=https://router.project-osrm.org
ROUTING_PROFILE=driving

# Online payments. Razorpay is enabled only when both keys are set (test keys from the Razorpay
# dashboard work). Without them, a clearly-labelled simulated provider is offered in development.
# Never commit real keys. PAYMENTS_MOCK=false hides the simulated provider.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Signs webhook calls to POST /api/v1/payments/webhooks/razorpay (set the same value in the dashboard).
RAZORPAY_WEBHOOK_SECRET=
PAYMENTS_MOCK=true

# Delivery OTP: a 4-digit code made at pickup, shown to the customer, needed to mark delivered.
DELIVERY_OTP_REQUIRED=true
DELIVERY_OTP_MAX_ATTEMPTS=5

# Browser push notifications (Web Push). Push is on only when both VAPID keys are set.
# Generate a pair once: npx web-push generate-vapid-keys (run in backend/). The private key never
# leaves the API; the public key is served to browsers by GET /api/v1/push/public-key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services (mailto: or https: URL).
VAPID_SUBJECT=mailto:support@bitebox.local
# Optional: push services subscriptions may point at (suffix match). Default covers Chrome/Edge (FCM),
# Firefox (Mozilla), Windows (WNS) and Safari/iOS (Apple).
# PUSH_ALLOWED_HOSTS=fcm.googleapis.com,push.services.mozilla.com,notify.windows.com,push.apple.com

