{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "npm --prefix frontend install",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist/frontend/browser",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://bitebox-backend-opal.vercel.app/api/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.csr.html"
    }
  ]
}

