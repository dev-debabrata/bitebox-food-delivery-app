# Settings for docker-compose (copy to deploy/.env). Never commit the real file.

# Public address of the site (what users type). Used for CORS, emails and image URLs.
PUBLIC_URL=http://localhost:8080
# Its host name only (no scheme or port), e.g. bitebox.example.com.
PUBLIC_HOST=localhost

# 32+ random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# 32 random bytes, base64: encrypts bank account and document numbers. Keep it safe and never
# change it once data exists (old values could not be read):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=

# Optional: real online payments (leave empty for cash on delivery only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: browser push notifications (npx web-push generate-vapid-keys).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# Optional: image hosting (otherwise images are kept in the "uploads" volume).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="BiteBox <no-reply@example.com>"
